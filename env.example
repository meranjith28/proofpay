# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox). Enable Payouts on the app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# AI providers: set one or more. They are tried in order (Anthropic, Groq, Gemini) with automatic fallback.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Postgres connection string
DATABASE_URL=

# Public URL of the app (http://localhost:3000 in development), used for the PayPal return link
APP_URL=http://localhost:3000

# Safety cap for any single automated payout, in USD
MAX_PAYOUT_USD=500
